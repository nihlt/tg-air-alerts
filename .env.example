api_id=123456
api_hash=your_telegram_api_hash

# Optional. If omitted, the script asks for the phone number interactively.
phone=+380XXXXXXXXX

# Optional. Use this instead of phone login when exporting with a bot account.
# bot_token=123456:your_bot_token

# Telegram alert bot (sendMessage / sendPhoto)
TG_BOT_TOKEN=123456:your_bot_token
# Default recipient for preview_tg_alert.py --send (debug bot replies to any user)
TELEGRAM_AUTHOR=123456789
